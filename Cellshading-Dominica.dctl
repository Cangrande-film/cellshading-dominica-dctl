// ============================================================================
//  Cellshading-Dominica.dctl
//  Killer7-style cel shading for live-action footage in DaVinci Resolve.
//
//  Pipeline:
//    1. Kuwahara flatten   - removes texture/noise while keeping edges hard
//    2. Exposure/contrast  - shapes the tone measure before thresholding
//    3. Shadow cut         - everything below a threshold becomes flat ink
//    4. Shadow pattern     - optional halftone / hatching near the shadow edge
//    5. Lit tone bands     - remaining tones are posterised into N flat levels
//    6. Highlight blowout  - top end clips to (near) white
//    7. Colour             - palette snap, monochrome or single-accent modes
//    8. Ink outlines       - Sobel edge detection
//    9. Output             - black/white point, saturation, mix
//
//  Input expected: display-referred Rec.709 (gamma 2.4). Place this after a
//  CST / LUT that converts your camera log to Rec.709.
//  Hue sliders are in degrees: 0 red, 60 yellow, 120 green, 180 cyan,
//  240 blue, 300 magenta.
// ============================================================================

// ============================================================================
//  PRESET - picks a saved look. Anything other than Custom ignores every
//  slider except Exposure, Effect Mix and View. Presets live further down in
//  this file: see BUILT-IN PRESETS and USER PRESETS.
// ============================================================================
DEFINE_UI_PARAMS(preset,          "Preset",                            DCTLUI_COMBO_BOX,    0, { PR_CUSTOM, PR_K7, PR_NOIR, PR_CRIMSON, PR_COMIC, PR_PEN, PR_SEPIA, PR_NAVY, PR_POP, PR_SOFT, PR_USER1, PR_USER2, PR_USER3, PR_USER4, PR_USER5, PR_USER6 }, { "Custom - Use Sliders", "Killer7 Classic", "Stark Noir", "Crimson Ink", "Halftone Comic", "Pen and Ink", "Sepia Woodcut", "Navy Night", "Pop Palette", "Soft Painted", "User 1", "User 2", "User 3", "User 4", "User 5", "User 6" })

