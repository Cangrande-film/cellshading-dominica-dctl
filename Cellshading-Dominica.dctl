// ============================================================================
//  Cellshading-Dominica.dctl
//  Killer7-style cel shading for live-action footage in DaVinci Resolve.
//
//  Pipeline:
//    1. Kuwahara flatten   - removes texture/noise while keeping edges hard
//    2. Exposure/contrast  - shapes the tone measure before thresholding
//    3. Shadow cut         - everything below a threshold becomes flat ink
//    4. Shadow pattern     - optional halftone / hatching near the shadow edge
//    5. Lit tone bands     - remaining tones are posterised into N flat levels
//    6. Highlight blowout  - top end clips to (near) white
//    7. Colour             - palette snap, monochrome or single-accent modes
//    8. Ink outlines       - Sobel edge detection
//    9. Output             - black/white point, saturation, mix
//
//  Input expected: display-referred Rec.709 (gamma 2.4). Place this after a
//  CST / LUT that converts your camera log to Rec.709.
//  Hue sliders are in degrees: 0 red, 60 yellow, 120 green, 180 cyan,
//  240 blue, 300 magenta.
// ============================================================================

// ============================================================================
//  MAIN CONTROLS - the sliders with the biggest effect on the final image
// ============================================================================
DEFINE_UI_PARAMS(shadowThresh,    "Shadow Threshold",                  DCTLUI_SLIDER_FLOAT, 0.30,  0.0,   1.0,   0.005)
DEFINE_UI_PARAMS(shadowStyle,     "Shadow Color",                      DCTLUI_COMBO_BOX,    0, { SH_BLACK, SH_SOURCE, SH_CRIMSON, SH_NAVY, SH_VIOLET, SH_CUSTOM }, { "Ink Black", "Source Hue", "Crimson", "Navy", "Violet", "Custom RGB" })
DEFINE_UI_PARAMS(tones,           "Tone Count",                        DCTLUI_SLIDER_INT,   2,     1,     8,     1)
DEFINE_UI_PARAMS(exposure,        "Exposure",                          DCTLUI_SLIDER_FLOAT, 0.0,  -3.0,   3.0,   0.01)
DEFINE_UI_PARAMS(contrast,        "Contrast",                          DCTLUI_SLIDER_FLOAT, 1.25,  0.5,   3.0,   0.01)
DEFINE_UI_PARAMS(colorMode,       "Color Mode",                        DCTLUI_COMBO_BOX,    0, { CM_PALETTE, CM_MONO, CM_ACCENT }, { "Snapped Palette", "Monochrome Tint", "Single Accent Color" })
DEFINE_UI_PARAMS(satAmt,          "Saturation",                        DCTLUI_SLIDER_FLOAT, 1.3,   0.0,   3.0,   0.01)
DEFINE_UI_PARAMS(highlightThresh, "Highlight Threshold",               DCTLUI_SLIDER_FLOAT, 0.85,  0.0,   1.0,   0.005)
DEFINE_UI_PARAMS(hiAmount,        "Highlight Blowout",                 DCTLUI_SLIDER_FLOAT, 1.0,   0.0,   1.0,   0.01)
DEFINE_UI_PARAMS(flatRadius,      "Flatten Radius",                    DCTLUI_SLIDER_INT,   2,     0,     6,     1)
DEFINE_UI_PARAMS(stabTone,        "Flicker Reduction",                 DCTLUI_SLIDER_FLOAT, 0.5,   0.0,   1.0,   0.01)
DEFINE_UI_PARAMS(drawLines,       "Outlines",                          DCTLUI_CHECK_BOX,    1)
DEFINE_UI_PARAMS(lineThresh,      "Outline Threshold",                 DCTLUI_SLIDER_FLOAT, 0.12,  0.01,  1.0,   0.005)
DEFINE_UI_PARAMS(lineWidth,       "Outline Width",                     DCTLUI_SLIDER_FLOAT, 1.0,   0.5,   6.0,   0.05)
DEFINE_UI_PARAMS(patternType,     "Shadow Pattern",                    DCTLUI_COMBO_BOX,    0, { PT_NONE, PT_HALFTONE, PT_HATCH, PT_CROSSHATCH }, { "None", "Halftone Dots", "Hatching", "Cross-Hatching" })
DEFINE_UI_PARAMS(mixAmt,          "Effect Mix",                        DCTLUI_SLIDER_FLOAT, 1.0,   0.0,   1.0,   0.01)
DEFINE_UI_PARAMS(viewMode,        "View",                              DCTLUI_COMBO_BOX,    0, { VM_FINAL, VM_SHADOW, VM_BANDS, VM_LINES, VM_FLAT }, { "Final", "Shadow Matte", "Tone Bands", "Outline Matte", "Flattened Source" })

// ============================================================================
//  ADVANCED - grouped by what they affect
// ============================================================================

// --- Tone: how brightness is measured and split into bands ---------------------
