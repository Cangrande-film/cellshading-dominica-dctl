// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

__DEVICE__ float luma(float3 c) {
    return 0.2126f * c.x + 0.7152f * c.y + 0.0722f * c.z;
}

__DEVICE__ float lerpf(float a, float b, float t) {
    return a + (b - a) * t;
}

__DEVICE__ float3 lerp3(float3 a, float3 b, float t) {
    return make_float3(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t);
}

__DEVICE__ float sstep(float e0, float e1, float x) {
    if (e1 <= e0) return x >= e0 ? 1.0f : 0.0f;
    float t = _saturatef((x - e0) / (e1 - e0));
    return t * t * (3.0f - 2.0f * t);
}

__DEVICE__ float wrap01(float x) {
    return x - _floor(x);
}

__DEVICE__ float hueDist(float a, float b) {
    float d = _fabs(a - b);
    return _fminf(d, 1.0f - d);
}

__DEVICE__ float3 fetch(__TEXTURE__ texR, __TEXTURE__ texG, __TEXTURE__ texB, int x, int y, int w, int h) {
    x = x < 0 ? 0 : (x > w - 1 ? w - 1 : x);
    y = y < 0 ? 0 : (y > h - 1 ? h - 1 : y);
    return make_float3(_tex2D(texR, x, y), _tex2D(texG, x, y), _tex2D(texB, x, y));
}

__DEVICE__ float toneOf(float3 c, int mode) {
    if (mode == 1) return _fmaxf(c.x, _fmaxf(c.y, c.z));
    if (mode == 2) return (c.x + c.y + c.z) / 3.0f;
    return luma(c);
}

__DEVICE__ float3 rgb2hsv(float3 c) {
    float mx = _fmaxf(c.x, _fmaxf(c.y, c.z));
    float mn = _fminf(c.x, _fminf(c.y, c.z));
    float d  = mx - mn;
    float h  = 0.0f;
    if (d > 1e-6f) {
        if (mx == c.x)      h = (c.y - c.z) / d;
        else if (mx == c.y) h = 2.0f + (c.z - c.x) / d;
        else                h = 4.0f + (c.x - c.y) / d;
        h /= 6.0f;
        if (h < 0.0f) h += 1.0f;
    }
    float s = mx > 1e-6f ? d / mx : 0.0f;
    return make_float3(h, s, mx);
}

__DEVICE__ float3 hsv2rgb(float h, float s, float v) {
    float r = _saturatef(_fabs(h * 6.0f - 3.0f) - 1.0f);
    float g = _saturatef(2.0f - _fabs(h * 6.0f - 2.0f));
    float b = _saturatef(2.0f - _fabs(h * 6.0f - 4.0f));
    return make_float3(v * ((r - 1.0f) * s + 1.0f),
                       v * ((g - 1.0f) * s + 1.0f),
                       v * ((b - 1.0f) * s + 1.0f));
}

// Build a flat colour with the given hue/sat whose Rec.709 luma equals targetY.
// If that overflows the gamut, desaturate toward grey until it fits.
__DEVICE__ float3 colorize(float h, float s, float targetY) {
    targetY = _saturatef(targetY);
    float3 c = hsv2rgb(h, s, 1.0f);
    float k = targetY / _fmaxf(luma(c), 1e-4f);
    c = make_float3(c.x * k, c.y * k, c.z * k);
    float m = _fmaxf(c.x, _fmaxf(c.y, c.z));
    if (m > 1.0f) {
        float f = (1.0f - targetY) / _fmaxf(m - targetY, 1e-4f);
        c = make_float3(targetY + (c.x - targetY) * f,
                        targetY + (c.y - targetY) * f,
                        targetY + (c.z - targetY) * f);
    }
    return c;
}

// Soft rounding to `steps` levels. w = 0 is a hard step; w = 0.5 is almost continuous.
// Values sitting on a step boundary blend instead of flipping, which avoids flicker.
__DEVICE__ float softQuant(float x, float steps, float w) {
    float v = x * steps;
    float i = _floor(v);
    float fr = v - i;
    w = _fminf(_fmaxf(w, 1e-4f), 0.5f);
    return (i + sstep(0.5f - w, 0.5f + w, fr)) / steps;
}

// Wide, cheap blur (centre + two rings of 8 samples) used as a stable reference
// for threshold decisions. Grain can't flip a pixel across a threshold when the
// decision is made on the neighbourhood average.
__DEVICE__ float3 stableBlur(__TEXTURE__ texR, __TEXTURE__ texG, __TEXTURE__ texB,
                             int px, int py, int w, int h, float radius) {
    float3 c = fetch(texR, texG, texB, px, py, w, h);
    float sr = c.x, sg = c.y, sb = c.z, wsum = 1.0f;
    for (int k = 0; k < 8; k++) {
        float a = (float)k * 0.785398f;
        float ca = _cosf(a), sa = _sinf(a);
        float3 c1 = fetch(texR, texG, texB, px + (int)(ca * radius * 0.5f), py + (int)(sa * radius * 0.5f), w, h);
        float3 c2 = fetch(texR, texG, texB, px + (int)(ca * radius), py + (int)(sa * radius), w, h);
        sr += c1.x * 0.8f + c2.x * 0.5f;
        sg += c1.y * 0.8f + c2.y * 0.5f;
        sb += c1.z * 0.8f + c2.z * 0.5f;
        wsum += 1.3f;
    }
    return make_float3(sr / wsum, sg / wsum, sb / wsum);
}

// Smooth 4-quadrant Kuwahara filter. Instead of hard-picking the least-varying
// quadrant (which jumps between quadrants frame to frame and flickers), each
// quadrant is weighted by (minStdDev / stdDev)^sharpness, so similar quadrants blend.
// Flattens skin/fabric texture into painted-looking patches with crisp edges.
__DEVICE__ float3 kuwahara(__TEXTURE__ texR, __TEXTURE__ texG, __TEXTURE__ texB,
                           int px, int py, int w, int h, int radius, int stride, float sharp) {
    float3 m0 = make_float3(0.0f, 0.0f, 0.0f), m1 = m0, m2 = m0, m3 = m0;
    float s0 = 0.0f, s1 = 0.0f, s2 = 0.0f, s3 = 0.0f;
    for (int q = 0; q < 4; q++) {
        int sx = (q & 1) ? 1 : -1;
        int sy = (q & 2) ? 1 : -1;
        float3 sum = make_float3(0.0f, 0.0f, 0.0f);
        float sumY = 0.0f, sumY2 = 0.0f;
        for (int j = 0; j <= radius; j++) {
            for (int i = 0; i <= radius; i++) {
                float3 c = fetch(texR, texG, texB, px + sx * i * stride, py + sy * j * stride, w, h);
                float y = luma(c);
                sum = make_float3(sum.x + c.x, sum.y + c.y, sum.z + c.z);
                sumY += y;
                sumY2 += y * y;
            }
        }
        float n = (float)((radius + 1) * (radius + 1));
        float meanY = sumY / n;
        float sd = _sqrtf(_fmaxf(sumY2 / n - meanY * meanY, 0.0f)) * 255.0f;
        float3 mean = make_float3(sum.x / n, sum.y / n, sum.z / n);
        if (q == 0)      { m0 = mean; s0 = sd; }
        else if (q == 1) { m1 = mean; s1 = sd; }
        else if (q == 2) { m2 = mean; s2 = sd; }
        else             { m3 = mean; s3 = sd; }
    }
    // 0.5 (in 8-bit units) keeps near-flat areas from amplifying tiny differences
    float sMin = _fminf(_fminf(s0, s1), _fminf(s2, s3)) + 0.5f;
    float w0 = _powf(sMin / (s0 + 0.5f), sharp);
    float w1 = _powf(sMin / (s1 + 0.5f), sharp);
    float w2 = _powf(sMin / (s2 + 0.5f), sharp);
    float w3 = _powf(sMin / (s3 + 0.5f), sharp);
    float ws = w0 + w1 + w2 + w3;
    return make_float3((m0.x * w0 + m1.x * w1 + m2.x * w2 + m3.x * w3) / ws,
                       (m0.y * w0 + m1.y * w1 + m2.y * w2 + m3.y * w3) / ws,
                       (m0.z * w0 + m1.z * w1 + m2.z * w2 + m3.z * w3) / ws);
}

// Tone at a point, optionally averaged over a 2x2 block to tame grain for edge detection.
__DEVICE__ float edgeTap(__TEXTURE__ texR, __TEXTURE__ texG, __TEXTURE__ texB,
                         int x, int y, int w, int h, int s, int smooth, int tmode) {
    float t = toneOf(fetch(texR, texG, texB, x, y, w, h), tmode);
    if (smooth) {
        t += toneOf(fetch(texR, texG, texB, x + s, y,     w, h), tmode);
        t += toneOf(fetch(texR, texG, texB, x,     y + s, w, h), tmode);
        t += toneOf(fetch(texR, texG, texB, x + s, y + s, w, h), tmode);
        t *= 0.25f;
    }
    return t;
}

// Screen-space shading pattern. density 0 = no lit marks, 1 = fully lit.
// Returns 1 where the lit colour should show through.
__DEVICE__ float shadePattern(int type, float px, float py, float cell, float angleDeg, float density) {
    float a = angleDeg * 3.14159265f / 180.0f;
    float ca = _cosf(a), sa = _sinf(a);
    float u = (px * ca - py * sa) / cell;
    float v = (px * sa + py * ca) / cell;
    float aa = 1.0f / cell;  // ~1 pixel anti-aliasing

    if (type == 1) {  // halftone dots
        float fu = wrap01(u) - 0.5f;
        float fv = wrap01(v) - 0.5f;
        float dist = _sqrtf(fu * fu + fv * fv);
        float radius = _sqrtf(density) * 0.7072f;
        return 1.0f - sstep(radius - aa, radius + aa, dist);
    }

    // hatching: stripe width proportional to density
    float fu = _fabs(wrap01(u) - 0.5f) * 2.0f;  // 0 at stripe centre, 1 at edge
    float lines = 1.0f - sstep(density - aa, density + aa, fu);
    if (type == 3) {  // cross-hatch: second set at 90 degrees, half the density each
        float fv = _fabs(wrap01(v) - 0.5f) * 2.0f;
        float d2 = density * 0.5f;
        float l1 = 1.0f - sstep(d2 - aa, d2 + aa, fu);
        float l2 = 1.0f - sstep(d2 - aa, d2 + aa, fv);
        lines = _fmaxf(l1, l2);
    }
    return lines;
}

// ---------------------------------------------------------------------------
// Presets
// Combo values in presets are the item index, counting from 0 in the order the
// combo lists them (e.g. colorMode 0 Snapped Palette, 1 Monochrome Tint, 2 Single Accent).
// ---------------------------------------------------------------------------

typedef struct {
    float shadowThresh;
    int shadowStyle;
    int tones;
    float contrast;
    int colorMode;
    float satAmt;
    float highlightThresh;
    float hiAmount;
    int flatRadius;
    float stabTone;
    int drawLines;
    float lineThresh;
    float lineWidth;
    int patternType;
    int toneMeasure;
    float pivot;
    float toneFloor;
    float toneCeil;
    float toneBias;
    float toneSoft;
    float shadowLevel;
    float shadowSoft;
    float shadowR;
    float shadowG;
    float shadowB;
    float hiLevel;
    float hiSoft;
    float hiColorKeep;
    float hueShift;
    int hueSteps;
    float hueSnap;
    int satSteps;
    float stepSoft;
    float monoHue;
    float monoSat;
    float accentHue;
    float accentWidth;
    float accentRest;
    float tintHue;
    float tintAmt;
    float lineStrength;
    float lineSoft;
    int lineColor;
    int lineLitOnly;
    int linePreSmooth;
    float patternRange;
    float patternSize;
    float patternAngle;
    float flatSpread;
    float flatSharp;
    float stabColor;
    float stabRadius;
    float outBlack;
    float outWhite;
    float outSat;
} Cfg;

__DEVICE__ Cfg cfgDefaults() {
    Cfg P;
    P.shadowThresh = 0.30f;
    P.shadowStyle = 0;
    P.tones = 2;
    P.contrast = 1.25f;
    P.colorMode = 0;
    P.satAmt = 1.3f;
    P.highlightThresh = 0.85f;
    P.hiAmount = 1.0f;
    P.flatRadius = 2;
    P.stabTone = 0.5f;
    P.drawLines = 1;
    P.lineThresh = 0.12f;
    P.lineWidth = 1.0f;
    P.patternType = 0;
    P.toneMeasure = 0;
    P.pivot = 0.42f;
    P.toneFloor = 0.40f;
    P.toneCeil = 0.72f;
    P.toneBias = 1.0f;
    P.toneSoft = 0.015f;
    P.shadowLevel = 0.03f;
    P.shadowSoft = 0.015f;
    P.shadowR = 0.10f;
    P.shadowG = 0.02f;
    P.shadowB = 0.05f;
    P.hiLevel = 0.97f;
    P.hiSoft = 0.015f;
    P.hiColorKeep = 0.15f;
    P.hueShift = 0.0f;
    P.hueSteps = 12;
    P.hueSnap = 0.8f;
    P.satSteps = 3;
    P.stepSoft = 0.1f;
    P.monoHue = 35.0f;
    P.monoSat = 0.25f;
    P.accentHue = 0.0f;
    P.accentWidth = 25.0f;
    P.accentRest = 0.0f;
    P.tintHue = 45.0f;
    P.tintAmt = 0.0f;
    P.lineStrength = 1.0f;
    P.lineSoft = 0.5f;
    P.lineColor = 0;
    P.lineLitOnly = 0;
    P.linePreSmooth = 1;
    P.patternRange = 0.10f;
    P.patternSize = 8.0f;
    P.patternAngle = 45.0f;
    P.flatSpread = 1.0f;
    P.flatSharp = 16.0f;
    P.stabColor = 0.3f;
    P.stabRadius = 6.0f;
    P.outBlack = 0.0f;
    P.outWhite = 1.0f;
    P.outSat = 1.0f;
    return P;
}

// === BUILT-IN PRESETS: defaults plus the listed changes ======================

// Killer7 Classic
__DEVICE__ Cfg presetK7() {
    Cfg P = cfgDefaults();
    return P;
}

// Stark Noir
__DEVICE__ Cfg presetNoir() {
    Cfg P = cfgDefaults();
    P.colorMode = 1;
    P.monoSat = 0.0f;
    P.tones = 1;
    P.shadowThresh = 0.36f;
    P.contrast = 1.6f;
    P.toneFloor = 0.62f;
    P.toneCeil = 0.62f;
    P.shadowLevel = 0.0f;
    P.lineColor = 1;
    P.hiAmount = 0.6f;
    return P;
}

// Crimson Ink
__DEVICE__ Cfg presetCrimson() {
    Cfg P = cfgDefaults();
    P.shadowStyle = 2;
    P.shadowLevel = 0.10f;
    P.colorMode = 2;
    P.accentHue = 0.0f;
    P.accentWidth = 30.0f;
    P.accentRest = 0.12f;
    P.satAmt = 1.6f;
    P.contrast = 1.4f;
    return P;
}

// Halftone Comic
__DEVICE__ Cfg presetComic() {
    Cfg P = cfgDefaults();
    P.tones = 3;
    P.satAmt = 1.6f;
    P.hueSteps = 8;
    P.hueSnap = 1.0f;
    P.patternType = 1;
    P.patternRange = 0.15f;
    P.patternSize = 7.0f;
    P.lineWidth = 1.5f;
    P.toneFloor = 0.35f;
    P.toneCeil = 0.85f;
    return P;
}

// Pen and Ink
__DEVICE__ Cfg presetPen() {
    Cfg P = cfgDefaults();
    P.colorMode = 1;
    P.monoHue = 40.0f;
    P.monoSat = 0.08f;
    P.tones = 3;
    P.patternType = 3;
    P.patternRange = 0.18f;
    P.patternSize = 6.0f;
    P.toneFloor = 0.55f;
    P.toneCeil = 0.95f;
    P.lineThresh = 0.08f;
    P.lineColor = 1;
    P.shadowLevel = 0.02f;
    return P;
}

// Sepia Woodcut
__DEVICE__ Cfg presetSepia() {
    Cfg P = cfgDefaults();
    P.colorMode = 1;
    P.monoHue = 32.0f;
    P.monoSat = 0.35f;
    P.patternType = 2;
    P.patternAngle = 30.0f;
    P.patternSize = 5.0f;
    P.contrast = 1.5f;
    P.shadowLevel = 0.06f;
    return P;
}

// Navy Night
__DEVICE__ Cfg presetNavy() {
    Cfg P = cfgDefaults();
    P.shadowStyle = 3;
    P.shadowLevel = 0.08f;
    P.satAmt = 0.8f;
    P.tintHue = 210.0f;
    P.tintAmt = 0.35f;
    P.highlightThresh = 0.92f;
    P.toneCeil = 0.62f;
    return P;
}

// Pop Palette
__DEVICE__ Cfg presetPop() {
    Cfg P = cfgDefaults();
    P.tones = 4;
    P.satAmt = 2.0f;
    P.hueSteps = 6;
    P.hueSnap = 1.0f;
    P.satSteps = 2;
    P.shadowStyle = 1;
    P.shadowLevel = 0.08f;
    P.toneFloor = 0.35f;
    P.toneCeil = 0.85f;
    return P;
}

// Soft Painted
__DEVICE__ Cfg presetSoft() {
    Cfg P = cfgDefaults();
    P.tones = 3;
    P.flatRadius = 3;
    P.lineWidth = 0.8f;
    P.lineStrength = 0.7f;
    P.shadowStyle = 4;
    P.shadowLevel = 0.15f;
    P.stepSoft = 0.15f;
    P.toneSoft = 0.03f;
    P.shadowSoft = 0.03f;
    return P;
}

// === USER PRESETS ===========================================================
// Each slot is a full snapshot. Fill them with save_preset.py, or by hand:
// copy a built-in preset's lines in, starting from  Cfg P = cfgDefaults();
// Keep the @user begin/end marker lines - the save script looks for them.

// @user 1 begin  - empty slot: returns the sliders unchanged
__DEVICE__ Cfg userPreset1(Cfg P) {
    return P;
}
// @user 1 end

// @user 2 begin  - empty slot: returns the sliders unchanged
__DEVICE__ Cfg userPreset2(Cfg P) {
    return P;
}
// @user 2 end

// @user 3 begin  - empty slot: returns the sliders unchanged
__DEVICE__ Cfg userPreset3(Cfg P) {
    return P;
}
// @user 3 end

// @user 4 begin  - empty slot: returns the sliders unchanged
__DEVICE__ Cfg userPreset4(Cfg P) {
    return P;
}
// @user 4 end

// @user 5 begin  - empty slot: returns the sliders unchanged
__DEVICE__ Cfg userPreset5(Cfg P) {
    return P;
}
// @user 5 end

// @user 6 begin  - empty slot: returns the sliders unchanged
__DEVICE__ Cfg userPreset6(Cfg P) {
    return P;
}
// @user 6 end

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE__ p_TexR, __TEXTURE__ p_TexG, __TEXTURE__ p_TexB)
{
    // Sliders, or the chosen preset in their place
    Cfg P;
    P.shadowThresh = shadowThresh;
    P.shadowStyle = shadowStyle;
    P.tones = tones;
    P.contrast = contrast;
    P.colorMode = colorMode;
    P.satAmt = satAmt;
    P.highlightThresh = highlightThresh;
    P.hiAmount = hiAmount;
    P.flatRadius = flatRadius;
    P.stabTone = stabTone;
    P.drawLines = drawLines;
    P.lineThresh = lineThresh;
    P.lineWidth = lineWidth;
    P.patternType = patternType;
    P.toneMeasure = toneMeasure;
    P.pivot = pivot;
    P.toneFloor = toneFloor;
    P.toneCeil = toneCeil;
    P.toneBias = toneBias;
    P.toneSoft = toneSoft;
    P.shadowLevel = shadowLevel;
    P.shadowSoft = shadowSoft;
    P.shadowR = shadowR;
    P.shadowG = shadowG;
    P.shadowB = shadowB;
    P.hiLevel = hiLevel;
    P.hiSoft = hiSoft;
    P.hiColorKeep = hiColorKeep;
    P.hueShift = hueShift;
    P.hueSteps = hueSteps;
    P.hueSnap = hueSnap;
    P.satSteps = satSteps;
    P.stepSoft = stepSoft;
    P.monoHue = monoHue;
    P.monoSat = monoSat;
    P.accentHue = accentHue;
    P.accentWidth = accentWidth;
    P.accentRest = accentRest;
    P.tintHue = tintHue;
    P.tintAmt = tintAmt;
    P.lineStrength = lineStrength;
    P.lineSoft = lineSoft;
    P.lineColor = lineColor;
    P.lineLitOnly = lineLitOnly;
    P.linePreSmooth = linePreSmooth;
    P.patternRange = patternRange;
    P.patternSize = patternSize;
    P.patternAngle = patternAngle;
    P.flatSpread = flatSpread;
    P.flatSharp = flatSharp;
    P.stabColor = stabColor;
    P.stabRadius = stabRadius;
    P.outBlack = outBlack;
    P.outWhite = outWhite;
    P.outSat = outSat;
    if (preset == PR_K7) { P = presetK7(); }
    else if (preset == PR_NOIR) { P = presetNoir(); }
    else if (preset == PR_CRIMSON) { P = presetCrimson(); }
    else if (preset == PR_COMIC) { P = presetComic(); }
    else if (preset == PR_PEN) { P = presetPen(); }
    else if (preset == PR_SEPIA) { P = presetSepia(); }
    else if (preset == PR_NAVY) { P = presetNavy(); }
    else if (preset == PR_POP) { P = presetPop(); }
    else if (preset == PR_SOFT) { P = presetSoft(); }
    else if (preset == PR_USER1) { P = userPreset1(P); }
    else if (preset == PR_USER2) { P = userPreset2(P); }
    else if (preset == PR_USER3) { P = userPreset3(P); }
    else if (preset == PR_USER4) { P = userPreset4(P); }
    else if (preset == PR_USER5) { P = userPreset5(P); }
    else if (preset == PR_USER6) { P = userPreset6(P); }

    float3 src = fetch(p_TexR, p_TexG, p_TexB, p_X, p_Y, p_Width, p_Height);

    // Keep the look consistent between HD / UHD / etc.
    float resScale = (float)p_Width / 1920.0f;
    int stride = (int)_fmaxf(1.0f, _floor(resScale * P.flatSpread + 0.5f));

    // 1. Flatten
    float3 flat = P.flatRadius > 0
        ? kuwahara(p_TexR, p_TexG, p_TexB, p_X, p_Y, p_Width, p_Height, P.flatRadius, stride, P.flatSharp)
        : src;

    // 1b. Stability reference: tone and colour decisions lean on a wide blur
    float3 stable = flat;
    if (P.stabTone > 0.0f || P.stabColor > 0.0f) {
        stable = stableBlur(p_TexR, p_TexG, p_TexB, p_X, p_Y, p_Width, p_Height, P.stabRadius * resScale);
    }
    float3 toneSrc  = lerp3(flat, stable, P.stabTone);
    float3 colorSrc = lerp3(flat, stable, P.stabColor);
    if (viewMode == VM_FLAT) return toneSrc;

    // 2. Exposure / P.contrast on the chosen tone measure
    int tmode = P.toneMeasure == TM_MAXRGB ? 1 : (P.toneMeasure == TM_AVERAGE ? 2 : 0);
    float expGain = _powf(2.0f, exposure);
    float Y = toneOf(toneSrc, tmode) * expGain;
    Y = P.pivot * _powf(_fmaxf(Y, 0.0f) / P.pivot, P.contrast);
    Y = _saturatef(Y);

    // 3. Shadow matte (1 = lit, 0 = shadow)
    float litMask = sstep(P.shadowThresh - P.shadowSoft, P.shadowThresh + P.shadowSoft, Y);
    if (viewMode == VM_SHADOW) return make_float3(litMask, litMask, litMask);

    // 5. Posterise the lit range into N equal-width bands with soft edges
    float range = _fmaxf(P.highlightThresh - P.shadowThresh, 1e-3f);
    float t = _powf(_saturatef((Y - P.shadowThresh) / range), P.toneBias);
    float qt = 0.5f;
    if (P.tones > 1) {
        float N = (float)P.tones;
        float v = t * N - 0.5f;
        float i = _floor(v);
        float fr = v - i;
        float w = _fminf(_fmaxf(P.toneSoft * N / range, 1e-4f), 0.5f);
        float level = i + sstep(0.5f - w, 0.5f + w, fr);
        level = _fminf(_fmaxf(level, 0.0f), N - 1.0f);
        qt = level / (N - 1.0f);
    }
    float bandY = lerpf(P.toneFloor, P.toneCeil, qt);

    // 7. Colour
    float3 hsv = rgb2hsv(colorSrc);
    float hue = wrap01(hsv.x + P.hueShift / 360.0f);
    float sat = _saturatef(hsv.y * P.satAmt);

    if (P.colorMode == CM_MONO) {
        hue = P.monoHue / 360.0f;
        sat = P.monoSat;
    } else {
        if (P.colorMode == CM_ACCENT) {
            float d = hueDist(hue, P.accentHue / 360.0f);
            float wdt = P.accentWidth / 360.0f;
            float keep = 1.0f - sstep(wdt * 0.6f, wdt, d);
            sat = sat * lerpf(P.accentRest, 1.0f, keep);
        }
        if (P.hueSteps > 0) {
            float hs = (float)P.hueSteps;
            float hq = softQuant(hue, hs, P.stepSoft);
            hue = wrap01(hue + (hq - hue) * P.hueSnap);
        }
        if (P.satSteps > 0) {
            float ss = (float)P.satSteps;
            sat = _saturatef(softQuant(sat, ss, P.stepSoft));
        }
    }

    float3 lit = colorize(hue, sat, bandY);
    if (P.tintAmt > 0.0f) lit = lerp3(lit, colorize(P.tintHue / 360.0f, 1.0f, bandY), P.tintAmt);

    // 3b. Shadow colour
    float3 shadowCol;
    if (P.shadowStyle == SH_SOURCE)       shadowCol = colorize(hue, sat, P.shadowLevel);
    else if (P.shadowStyle == SH_CRIMSON) shadowCol = colorize(0.985f, 0.9f, P.shadowLevel);
    else if (P.shadowStyle == SH_NAVY)    shadowCol = colorize(0.62f,  0.8f, P.shadowLevel);
    else if (P.shadowStyle == SH_VIOLET)  shadowCol = colorize(0.76f,  0.7f, P.shadowLevel);
    else if (P.shadowStyle == SH_CUSTOM)  shadowCol = make_float3(P.shadowR, P.shadowG, P.shadowB);
    else                                shadowCol = make_float3(P.shadowLevel, P.shadowLevel, P.shadowLevel);

    // 4. Shadow pattern: lit marks inside the band just below the threshold
    float patMask = 0.0f;
    if (P.patternType != PT_NONE && P.patternRange > 0.0f) {
        int ptype = P.patternType == PT_HALFTONE ? 1 : (P.patternType == PT_HATCH ? 2 : 3);
        float density = _saturatef((Y - (P.shadowThresh - P.patternRange)) / P.patternRange);
        float cell = _fmaxf(P.patternSize * resScale, 1.0f);
        patMask = shadePattern(ptype, (float)p_X, (float)p_Y, cell, P.patternAngle, density)
                  * (density > 0.0f ? 1.0f : 0.0f) * (1.0f - litMask);
    }
    float3 patCol = colorize(hue, sat, P.toneFloor);
    if (P.tintAmt > 0.0f) patCol = lerp3(patCol, colorize(P.tintHue / 360.0f, 1.0f, P.toneFloor), P.tintAmt);

    if (viewMode == VM_BANDS) {
        float b = lerpf(P.shadowLevel, bandY, litMask);
        b = lerpf(b, P.toneFloor, patMask);
        return make_float3(b, b, b);
    }

    float3 col = lerp3(shadowCol, lit, litMask);
    col = lerp3(col, patCol, patMask);

    // 6. Highlight blowout
    float hiMask = sstep(P.highlightThresh - P.hiSoft, P.highlightThresh + P.hiSoft, Y) * P.hiAmount;
    float3 hiCol = colorize(hue, sat * P.hiColorKeep, P.hiLevel);
    col = lerp3(col, hiCol, hiMask);

    // 8. Ink outlines (Sobel on source)
    float lineMask = 0.0f;
    if (P.drawLines || viewMode == VM_LINES) {
        int d = (int)_fmaxf(1.0f, _floor(P.lineWidth * resScale + 0.5f));
        int x = p_X, y = p_Y, W = p_Width, H = p_Height;
        int s = (int)_fmaxf(1.0f, _floor(resScale + 0.5f));
        float tl = edgeTap(p_TexR, p_TexG, p_TexB, x - d, y - d, W, H, s, P.linePreSmooth, tmode);
        float tc = edgeTap(p_TexR, p_TexG, p_TexB, x,     y - d, W, H, s, P.linePreSmooth, tmode);
        float tr = edgeTap(p_TexR, p_TexG, p_TexB, x + d, y - d, W, H, s, P.linePreSmooth, tmode);
        float ml = edgeTap(p_TexR, p_TexG, p_TexB, x - d, y,     W, H, s, P.linePreSmooth, tmode);
        float mr = edgeTap(p_TexR, p_TexG, p_TexB, x + d, y,     W, H, s, P.linePreSmooth, tmode);
        float bl = edgeTap(p_TexR, p_TexG, p_TexB, x - d, y + d, W, H, s, P.linePreSmooth, tmode);
        float bc = edgeTap(p_TexR, p_TexG, p_TexB, x,     y + d, W, H, s, P.linePreSmooth, tmode);
        float br = edgeTap(p_TexR, p_TexG, p_TexB, x + d, y + d, W, H, s, P.linePreSmooth, tmode);
        float gx = (tr + 2.0f * mr + br) - (tl + 2.0f * ml + bl);
        float gy = (bl + 2.0f * bc + br) - (tl + 2.0f * tc + tr);
        float mag = _sqrtf(gx * gx + gy * gy) * 0.25f * expGain;
        lineMask = sstep(P.lineThresh, P.lineThresh * (1.0f + P.lineSoft) + 1e-4f, mag);
        if (P.lineLitOnly) lineMask *= litMask;
    }
    if (viewMode == VM_LINES) return make_float3(1.0f - lineMask, 1.0f - lineMask, 1.0f - lineMask);
    if (P.drawLines) {
        float3 inkCol;
        if (P.lineColor == LC_BLACK)       inkCol = make_float3(0.0f, 0.0f, 0.0f);
        else if (P.lineColor == LC_WHITE)  inkCol = make_float3(1.0f, 1.0f, 1.0f);
        else if (P.lineColor == LC_INVERT) inkCol = make_float3(1.0f - col.x, 1.0f - col.y, 1.0f - col.z);
        else                             inkCol = shadowCol;
        col = lerp3(col, inkCol, lineMask * P.lineStrength);
    }

    // 9. Output
    if (P.outSat != 1.0f) {
        float l = luma(col);
        col = make_float3(l + (col.x - l) * P.outSat, l + (col.y - l) * P.outSat, l + (col.z - l) * P.outSat);
    }
    float span = P.outWhite - P.outBlack;
    col = make_float3(P.outBlack + _saturatef(col.x) * span,
                      P.outBlack + _saturatef(col.y) * span,
                      P.outBlack + _saturatef(col.z) * span);

    return lerp3(src, col, mixAmt);
}
